{
  "name": "omek-leads-server",
  "version": "1.0.0",
  "description": "Express + Prisma API for Omek Leads",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hash-password": "tsx scripts/hash-password.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "migrate:timeline": "tsx scripts/migrate-timeline.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@prisma/client": "^6.19.3",
    "baileys": "7.0.0-rc14",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.16.0"
  }
}
