# MongoDB connection. Paste your Atlas string (mongodb+srv://…) with the database name before the "?",
# or keep this one for the docker-compose.yml in this folder.
DATABASE_URL="mongodb://localhost:27017/omek_leads?directConnection=true"

# The one account that can sign in. Create the hash with: npm run hash-password
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""

PORT=4000

# production turns on Secure cookies (HTTPS only) and HSTS.
NODE_ENV=development

# How long you stay signed in without opening the app. Sessions renew while you use it, so with a year
# (the default) you stay signed in on your phone like in any app. Lower it for a shared computer.
SESSION_TTL_DAYS=365

# Behind a hosting proxy (Render, Railway, Fly, Heroku) set this to 1,
# so rate limits see each visitor's real IP instead of the proxy's.
TRUST_PROXY=0

# "Today" turns over at midnight in this time zone, and each day draws this many leads.
APP_TIMEZONE=Asia/Jerusalem
DAILY_QUOTA=10

# Built frontend to serve from this server (run `npm run build` in the project root first).
FRONTEND_DIST=../dist

# AI sales coach (optional), also used by objection training and the Prospector: anthropic, openai or gemini,
# with that provider's API key. gemini has a free tier: create a key at https://aistudio.google.com/app/apikey.
# On the free tier Google may use and have people review what is sent; turn on billing for your key's
# project to stop that (see "The AI sales coach" in README.md).
# Only names, the campaign, stage, approach notes and the timeline are sent; never phone numbers,
# emails or websites. Leave AI_PROVIDER empty to turn the coach off.
AI_PROVIDER=
AI_API_KEY=
# Defaults: claude-sonnet-5-5 (anthropic), gpt-6-astra (openai), gemini-3.8-flash (gemini)
# AI_MODEL=
# What you sell, in your own words. Empty, the AI is given Studio Omek's offer as written in
# src/coach/prompt.ts (landing pages, brochure and 3D sites, a free homepage mockup, managed hosting at
# $20 a month). Scripts and answers only have you claim what it says; a price list here also guides the
# deal analysis's price recommendation, along with the deals you already closed.
# AI_BUSINESS_CONTEXT=

# Automatic transcripts of call and Zoom recordings, added to their timeline entries for the coach.
# Needs an OpenAI key (AI_API_KEY is used when AI_PROVIDER=openai) and ffmpeg, which npm install provides.
# Recordings are sent to OpenAI to be transcribed.
TRANSCRIBE_API_KEY=
TRANSCRIBE_LANGUAGE=he
# Names and terms to spell right, comma separated:
# TRANSCRIBE_KEYWORDS="Omek, Zoom, WordPress"
# TRANSCRIBE_MODEL=gpt-transcribe
# Minutes per part sent for transcription (each part stays far under OpenAI's 25 MB limit):
# TRANSCRIBE_PART_MINUTES=10
# An OpenAI-compatible service instead, such as a Whisper server you run yourself (the part before /v1):
# TRANSCRIBE_BASE_URL=http://localhost:8000
# TRANSCRIBE=off
# FFMPEG_PATH=/usr/bin/ffmpeg

# Read-only WhatsApp sync (optional): mirrors your chats with leads onto their timelines and transcribes
# voice notes. It never sends anything. Link it from the WhatsApp icon in the app once it's on.
# WHATSAPP=on
# 32 random bytes that seal the linked device's keys in the database: openssl rand -base64 32
# WHATSAPP_AUTH_KEY=
# For lead numbers written without a country code (054… becomes 97254…):
# WHATSAPP_COUNTRY_CODE=972
# full: all of your phone's history when linking. recent: the last few months.
# WHATSAPP_HISTORY=full
# Voice notes newer than this many days are downloaded and transcribed as they sync:
# WHATSAPP_VOICE_DAYS=30
# WHATSAPP_LOG=warn

# Prospector (optional): finds local businesses by niche and area, checks their websites and scores
# how much they need a new one (1-5). It only reads: one search request, then a GET of each homepage.
# A SerpApi key (free plan: 250 searches a month, no card), a Google Cloud key with "Places API (New)"
# enabled (1,000 free requests a month, billing account needed), or both. With both, SerpApi searches first
# and Google Places takes over by itself when SerpApi's searches run out, its key is refused or it's down.
# SERPAPI_KEY=
# GOOGLE_PLACES_API_KEY=
# Which one searches first (default: serpapi when its key is set):
# PROSPECTOR_PROVIDER=serpapi
# off: never fall back to the other one (for example, to keep Google Places from being used at all):
# PROSPECTOR_FALLBACK=on
# A Chrome or Chromium executable, for phone-size screenshots and layout checks (optional):
# PROSPECTOR_CHROME_PATH=/usr/bin/chromium
# Working sites are scored by the AI coach's provider (AI_PROVIDER, AI_API_KEY); off scores by the signals alone.
# PROSPECTOR_AI=on
# PROSPECTOR_AI_MODEL=
# Search results are deleted after this many days (30 at most, per Google's terms); imported leads stay.
# PROSPECTOR_RETENTION_DAYS=30
# PROSPECTOR_LANGUAGE=he
# PROSPECTOR_REGION=IL

# Call and Zoom recordings. local keeps them in MEDIA_DIR on this machine. On hosts whose disk is
# wiped on every deploy (Render, Railway, Fly without a volume), use s3 instead.
MEDIA_STORAGE=local
MEDIA_DIR=./uploads
MAX_UPLOAD_MB=500
# With MEDIA_STORAGE=s3 (AWS, or Cloudflare R2, Backblaze B2 and MinIO through S3_ENDPOINT):
# S3_BUCKET=omek-recordings
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Only when the frontend is on a different domain than this API (see README):
# CORS_ORIGINS="https://crm.example.com"
# COOKIE_SAMESITE=none

# Optional: run `npm test` against MongoDB instead of in-memory stores.
# The database is emptied first, so its name must end in _test.
# TEST_DATABASE_URL="mongodb://localhost:27017/omek_leads_test?directConnection=true"
